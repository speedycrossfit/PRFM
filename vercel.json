{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-static.cjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/performance-mindset.pdf",
      "headers": [
        { "key": "Content-Type", "value": "application/pdf" },
        { "key": "Content-Disposition", "value": "inline; filename=\"performance-mindset.pdf\"" }
      ]
    }
  ]
}
